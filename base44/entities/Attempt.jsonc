{
  "name": "Attempt",
  "type": "object",
  "properties": {
    "level_id": {
      "type": "number"
    },
    "time_taken_seconds": {
      "type": "number"
    },
    "moves_used": {
      "type": "number"
    },
    "optimal_moves": {
      "type": "number"
    },
    "completed": {
      "type": "boolean"
    },
    "perfect": {
      "type": "boolean"
    },
    "switches_toggled": {
      "type": "number"
    },
    "date": {
      "type": "string"
    },
    "difficulty": {
      "type": "number",
      "default": 1
    },
    "skill_scores": {
      "type": "object",
      "default": {},
      "properties": {
        "planning": {
          "type": "number"
        },
        "efficiency": {
          "type": "number"
        },
        "adaptability": {
          "type": "number"
        },
        "persistence": {
          "type": "number"
        }
      }
    },
    "stars": {
      "type": "number",
      "default": 0
    }
  },
  "required": []
}